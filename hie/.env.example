# SEDISH hie stack — copy to .env to override. Defaults match the dev swarm.

# Source iSantePlus MySQL (replication client), reached over mysql_public as `mysql`
SRC_HOST=mysql
SRC_USER=consolidated
SRC_PASS=consolidated
SOURCE_SCHEMAS=openmrs,openmrs2
# facility database -> production site code (mspp_code)
SCHEMA_MSPP=openmrs=11106,openmrs2=22207

# Consolidated MySQL (built on the production schema; also hosts the SQLMesh output)
CONSOLIDATED_ROOT_PW=consolidated
CONSOLIDATED_DB=consolidated_db
FHIR_DB_NAME=fhir

# Pipeline driver: kafka (event-driven, default) | poll
RUN_MODE=kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=fhir.patient.changed
KAFKA_GROUP=fhir-pipeline
DEBOUNCE_SECONDS=5

# OpenHIM channels (push targets)
# enroll as our own client so OpenCR shows submitting system "Consolidated Server"
OPENCR_URL=http://openhim-core:5001/CR/fhir
OPENCR_USER=consolidated
OPENCR_PASS=consolidated
SHR_URL=http://openhim-core:5001/SHR/fhir
SHR_USER=consolidated
SHR_PASS=consolidated
NATIONAL_ID_SYSTEM=http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code
