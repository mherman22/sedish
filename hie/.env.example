# SEDISH hie stack — copy to .env to override. Defaults match the dev swarm.

# Consolidé MySQL (EXTERNAL — CHARESS provides these). SQLMesh reads consolidated_db
# and writes its fhir/ref/state schemas here, so the user needs CREATE/write privileges.
# (No defaults: the stack refuses to start until these are set.)
CONSOLIDATED_HOST=
CONSOLIDATED_PORT=3306
CONSOLIDATED_USER=
CONSOLIDATED_PASS=
FHIR_DB_NAME=fhir

# Pipeline image tag (GHCR package published by the sedish-fhir-pipeline repo CI):
# `main` (latest), `sha-<commit>`, or a `v*` release tag.
PIPELINE_TAG=main

# Pipeline driver: poll (timer, default — no dependency on a Consolidé event stream)
# | kafka (only if Consolidé publishes patient-changed events; then set KAFKA_BROKERS)
RUN_MODE=poll
INTERVAL=30

# Phase 1: push Patient identities to OpenCR only (MPI). Set MPI_ONLY=0 for Phase 2 (clinical → SHR).
MPI_ONLY=1
SOURCE_KEY_SYSTEM=http://sedish-haiti.org/fhir/source-key

# OpenHIM channels (push targets)
# enroll as our own client so OpenCR shows submitting system "Consolidated Server"
OPENCR_URL=http://openhim-core:5001/CR/fhir
OPENCR_USER=consolidated
OPENCR_PASS=consolidated
SHR_URL=http://openhim-core:5001/SHR/fhir
SHR_USER=consolidated
SHR_PASS=consolidated
NATIONAL_ID_SYSTEM=http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code
