# --- Source: CHARESS consolidated_db (read-only; creds via secure channel) ---
SRC_HOST=54.200.60.231        # public IP for now; private VPC IP + VPN coming
SRC_PORT=3310
SRC_USER=readonly
SRC_PASS=                      # provided separately by CHARESS
SRC_DB=consolidated_db

# --- Destinations (via OpenHIM) ---
OPENCR_URL=http://openhim-core:5001/CR/fhir
OPENCR_USER=openshr
OPENCR_PASS=openshr
SHR_URL=http://openhim-core:5001/SHR/fhir
SHR_USER=shr-pipeline
SHR_PASS=instant101

# --- FHIR system URIs (CHARESS to provide; MUST match OpenCR config.json) ---
# identifier_type -> system. Must include OpenCR's `internalid` systems or OpenCR
# rejects the patient ("no identifier for internalid"). Defaults = SEDISH OpenCR config.
IDENTIFIER_TYPE_SYSTEMS={"3":"http://isanteplus.org/openmrs/fhir2/3-isanteplus-id","5":"http://isanteplus.org/openmrs/fhir2/5-code-national","6":"http://isanteplus.org/openmrs/fhir2/6-code-st"}
MRN_SYSTEM_BASE=http://sedish.sedishtest.live   # fallback for unmapped identifier types
# national_id system: route into the biometrics system so OpenCR's biometric rule
# dedups DOUBLON cross-site (shared national_id -> one golden record). CHARESS/OpenCR to finalize.
NATIONAL_ID_SYSTEM=http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code

# --- Run control ---
SITE_FILTER=                   # comma-separated mspp_codes; empty = all sites
RUN_INTERVAL=0                 # seconds between runs; 0 = run once and exit
DRY_RUN=                       # 1 = build FHIR but don't push (safe dev/testing)
STATE_PATH=/data/etl_state.json
