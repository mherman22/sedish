# Source (iSantePlus) MySQL — reached over the mysql_public overlay as host `mysql`
SRC_HOST=mysql
SRC_USER=consolidated
SRC_PASS=consolidated
# Comma-separated facility databases to consolidate
SOURCE_SCHEMAS=openmrs,openmrs2
# facility database -> production site code (mspp_code); how consolidated_db
# distinguishes facilities (its tables are keyed/partitioned on mspp_code)
SCHEMA_MSPP=openmrs=11106,openmrs2=22207

# Consolidated MySQL (created by this stack) — built on the production schema
# (schema/consolidated_db_schema.sql), MySQL 8 to match production.
CONSOLIDATED_ROOT_PW=consolidated
CONSOLIDATED_DB=consolidated_db

# WRITE path: Jembi platform hapi-proxy — writes to SHR HAPI AND emits to Kafka
# 2xx -> unbundler -> patient/observation topics (downstream MPI/analytics/reprocess).
WRITE_URL=http://hapi-proxy:18080/fhir
# hapi-proxy rejects very large bundles (418); chunk global syncs:
GLOBAL_CHUNK=100
# READ path (parity/lookups): SHR passthrough via OpenHIM
SHR_URL=http://openhim-core:5001/SHR/fhir
SHR_USER=shr-pipeline
SHR_PASS=instant101
# EMR fhir2 API creds (CDC-triggered fhir2 publisher pulls patient FHIR from here)
EMR_USER=admin
EMR_PASS=Admin123
# MPI (OpenCR) enrollment — the fingerprint/identity -> MPI path
CR_URL=http://openhim-core:5001/CR/fhir
CR_USER=openshr
CR_PASS=openshr
ENROLL_MPI=1
# sync global (non-patient-scoped) resources to the SHR
SYNC_GLOBALS=1
GLOBAL_RESOURCES=Practitioner,Location

# Kafka backbone (Pattern A): reader produces patient-changed events, publisher consumes
ENABLE_KAFKA=1
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=fhir.patient.changed
KAFKA_GROUP=consolidated-shr
# seconds between publish runs; the stack default is 3600 (hourly, like the EMR pipeline)
PUBLISH_INTERVAL=3600
# set to 1 to republish every patient regardless of the high-water mark (full resync)
FORCE_FULL=
