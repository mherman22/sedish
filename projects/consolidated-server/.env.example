# Source (iSantePlus) MySQL — reached over the mysql_public overlay as host `mysql`
SRC_HOST=mysql
SRC_USER=consolidated
SRC_PASS=consolidated
# Comma-separated facility databases to consolidate
SOURCE_SCHEMAS=openmrs,openmrs2

# Consolidated MySQL (created by this stack)
CONSOLIDATED_ROOT_PW=consolidated
CONSOLIDATED_DB=consolidated
