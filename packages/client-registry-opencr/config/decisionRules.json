{
  "__comments": {
    "scoring": "boost_mode=replace: score is the sum of field similarities only, no BM25.",
    "asymmetry": "False merges are the intolerable error: auto-link on exact agreement, send fuzziness to review.",
    "fhirpaths": "Simple paths or .where() only; extension('url') 500s the match.",
    "espaths": "Must exist in PatientRelationship.json, which defines the ES index; an unindexed espath silently makes a rule dead.",
    "null_handling": "Conservative everywhere: an absent field never counts as a match.",
    "thresholds": "Scoring is binary per field: the plugin gives a field its weight when similarity reaches its threshold, else 0, so totals are whole numbers. auto = field count (every field agrees); potential = one short, which is the review band. A fractional potential threshold is unreachable and silently drops those candidates."
  },
  "rules": [
    {
      "__description": "Biometric (fpnid) plus both names exact.",
      "matchingType": "deterministic",
      "rule": "1",
      "fields": {
        "biometric": {
          "algorithm": "exact",
          "fhirpath": "identifier.where(system='http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code').value",
          "espath": "biometric",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 2.0,
      "autoMatchThreshold": 3.0
    },
    {
      "__description": "Demographics: both names and gender exact, birthDate fuzzy.",
      "matchingType": "deterministic",
      "rule": "2",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "damerau-levenshtein",
          "threshold": 0.8,
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.0,
      "autoMatchThreshold": 4.0
    },
    {
      "__description": "Mother correlator: both names, mother fuzzy, exact birthDate, no gender.",
      "matchingType": "deterministic",
      "rule": "3",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "mother_given": {
          "algorithm": "jaro-winkler-similarity",
          "threshold": 0.8,
          "fhirpath": "contact.name.text",
          "espath": "mother_given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "exact",
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.0,
      "autoMatchThreshold": 4.0
    },
    {
      "__description": "Phone plus both names and gender, for patients with no strong id.",
      "matchingType": "deterministic",
      "rule": "4",
      "fields": {
        "phone": {
          "algorithm": "exact",
          "fhirpath": "telecom.where(system='phone').value",
          "espath": "phone",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.0,
      "autoMatchThreshold": 4.0
    },
    {
      "__description": "Names transposed: given is compared against family and vice versa.",
      "matchingType": "deterministic",
      "rule": "5",
      "fields": {
        "given_as_family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family_as_given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "exact",
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.0,
      "autoMatchThreshold": 4.0
    }
  ]
}
