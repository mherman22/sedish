{
  "__comments": {
    "scoring": "boost_mode=replace: score = SUM of per-field similarities only (exact=1.0, fuzzy=measured). autoMatchThreshold = every field of the rule at/above its threshold; potential just below routes to CRUX review. BM25 relevance no longer leaks into the score (it silently bypassed the given-name requirement before).",
    "asymmetry": "False merges are the intolerable error. Auto-link only on biometric match or full exact agreement; any fuzziness routes to review.",
    "opencr_constraints": "fhirpaths must be simple paths or .where() only. Do NOT use extension('url') — it 500s the match. mother uses contact.name.text (pipeline must emit mother as a Patient.contact name). Junk mother/phone values blacklisted upstream.",
    "null_handling": "conservative everywhere: absent field never counts as a match.",
    "consolidation": "Reduced from 6 rules. Old Rule 2 (exact-DOB demographics) was subsumed by the fuzzy-DOB demographics rule (same auto-link set, superset review set). Old Rule 4 (fully-fuzzy) only reached its threshold at exact agreement, which demographics already auto-links, so it surfaced nothing distinct. Remaining four signatures are irreducible."
  },
  "rules": [
    {
      "__description": "Biometric (fpnid): strong SEDISH identifier, pre-deduplicated by M2SYS. Auto-links on ID match.",
      "matchingType": "deterministic",
      "rule": "1",
      "fields": {
        "biometric": {
          "algorithm": "exact",
          "fhirpath": "identifier.where(system='http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code').value",
          "espath": "biometric",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 2.8,
      "autoMatchThreshold": 3.0
    },
    {
      "__description": "Demographics: given + family + gender exact, birthDate fuzzy (damerau-levenshtein, catches DOB typos). Auto-links when demographics align; a fuzzy DOB keeps it at review. Subsumes old Rules 2, 4, 5.",
      "matchingType": "deterministic",
      "rule": "2",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "damerau-levenshtein",
          "threshold": 0.8,
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.4,
      "autoMatchThreshold": 3.8
    },
    {
      "__description": "Mother correlator: given + family + mother (fuzzy) + birthDate, NO gender (survives mis-entered sex). Auto-links on full agreement.",
      "matchingType": "deterministic",
      "rule": "3",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "mother_given": {
          "algorithm": "jaro-winkler-similarity",
          "threshold": 0.8,
          "fhirpath": "contact.name.text",
          "espath": "mother_given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "exact",
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.4,
      "autoMatchThreshold": 3.8
    },
    {
      "__description": "Phone + demographics: phone + given + family + gender, for patients without a strong identifier. Auto-links on full agreement.",
      "matchingType": "deterministic",
      "rule": "4",
      "fields": {
        "phone": {
          "algorithm": "exact",
          "fhirpath": "telecom.where(system='phone').value",
          "espath": "phone",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 3.4,
      "autoMatchThreshold": 4.0
    }
  ]
}