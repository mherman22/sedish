{
  "__comments": {
    "source": "Aligned to the CHARESS/DIGI SEDISH identity spec (SEDISH-Architecture-Deduplication-Identity-EN.pdf), section 7 + the canonical decision-rules JSON. This is the authoritative 6-rule deterministic cascade.",
    "scoring": "Rule total = 1.0 baseline + sum of matching fields (exact = 1.0, fuzzy = measured similarity between threshold and 1.0). potentialMatchThreshold -> candidate surfaced for human review (CRUX); autoMatchThreshold -> auto-link. A score between the two is NEVER merged silently.",
    "asymmetry": "A false merge is the one intolerable error. Only the biometric rule and rules with FULL field agreement auto-link. The fully-fuzzy rule (rule 4) is deliberately calibrated so it can never reach its auto threshold -> always human review.",
    "identifier_systems": "fhirpaths use the identifier systems / extensions the SEDISH pipeline ACTUALLY emits today (biometric = isanteplus 6-biometrics-national-reference-code; mother = HL7 patient-mothersMaidenName extension). The spec's proposed urn:sedish:ht:* URIs are a future canonicalization; if adopted, change them here AND in the pipeline + EMR feed together so all three stay consistent.",
    "threshold": {
      "jaro-winkler": "0 = no match, 1 = exact match",
      "DateDamerau": "0 = no match, 1 = exact match (handles date typos)"
    },
    "null_handling": "conservative everywhere: an absent field is NOT a match, so missing data can never, on its own, produce a link."
  },
  "rules": [
    {
      "__description": "Rule 1 — Biometric (fpnid): the strong, deterministic SEDISH identifier, pre-deduplicated by M2SYS. Auto-links on a true national-biometric-id match.",
      "matchingType": "deterministic",
      "rule": "1",
      "fields": {
        "biometric": {
          "algorithm": "exact",
          "fhirpath": "identifier.where(system='http://isanteplus.org/openmrs/fhir2/6-biometrics-national-reference-code').value",
          "espath": "biometric",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 2,
      "autoMatchThreshold": 2
    },
    {
      "__description": "Rule 2 — Exact demographics: given + family + gender + birthDate. Auto-links on full agreement.",
      "matchingType": "deterministic",
      "rule": "2",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "exact",
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 4,
      "autoMatchThreshold": 5
    },
    {
      "__description": "Rule 3 — Mother's-name correlator (SEDISH-specific): given + family + mother (fuzzy) + birthDate, NO gender, so a patient is still recognized when sex was mis-entered. Mother is read from the HL7 patient-mothersMaidenName extension the pipeline emits; junk mother values are blacklisted upstream so they cannot create false matches. Auto-links on full agreement.",
      "matchingType": "deterministic",
      "rule": "3",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "mother_given": {
          "algorithm": "jaro-winkler-similarity",
          "threshold": 0.8,
          "fhirpath": "extension('http://hl7.org/fhir/StructureDefinition/patient-mothersMaidenName').value",
          "espath": "mother_given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "exact",
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 4,
      "autoMatchThreshold": 5
    },
    {
      "__description": "Rule 4 — Fully fuzzy demographics: jaro-winkler names + exact gender + DateDamerau birthDate (typos). DELIBERATELY can never reach its auto threshold (max attainable score 5.0 < auto 6) -> always routed to human review, never auto-merged.",
      "matchingType": "deterministic",
      "rule": "4",
      "fields": {
        "family": {
          "algorithm": "jaro-winkler-similarity",
          "threshold": 0.8,
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "jaro-winkler-similarity",
          "threshold": 0.8,
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "DateDamerau",
          "threshold": 0.8,
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 5,
      "autoMatchThreshold": 6
    },
    {
      "__description": "Rule 5 — Exact names + fuzzy date: given + family + gender exact, birthDate via DateDamerau (catches DOB typos with exact names). Auto-links on agreement.",
      "matchingType": "deterministic",
      "rule": "5",
      "fields": {
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "birthDate": {
          "algorithm": "DateDamerau",
          "threshold": 0.8,
          "fhirpath": "birthDate",
          "espath": "birthDate",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 4,
      "autoMatchThreshold": 5
    },
    {
      "__description": "Rule 6 — Phone + demographics: phone + given + family + gender, for patients without a strong identifier. Auto-links on full agreement. Junk phone values are blacklisted upstream.",
      "matchingType": "deterministic",
      "rule": "6",
      "fields": {
        "phone": {
          "algorithm": "exact",
          "fhirpath": "telecom.where(system='phone').value",
          "espath": "phone",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "given": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').given",
          "espath": "given",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "family": {
          "algorithm": "exact",
          "fhirpath": "name.where(use='official').family",
          "espath": "family",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        },
        "gender": {
          "algorithm": "exact",
          "fhirpath": "gender",
          "espath": "gender",
          "null_handling": "conservative",
          "null_handling_both": "conservative"
        }
      },
      "potentialMatchThreshold": 4,
      "autoMatchThreshold": 5
    }
  ]
}
