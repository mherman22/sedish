{
  "urn": "urn:mediator:haiti_sharedhealthrecord",
  "version": "1.2.1",
  "name": "Haiti SHR",
  "description": "Haiti Shared Health Record",
  "defaultChannelConfig": [
    {
      "methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH"
      ],
      "type": "http",
      "whitelist": [],
      "authType": "private",
      "matchContentTypes": [],
      "properties": [],
      "txViewAcl": [],
      "txViewFullAcl": [],
      "txRerunAcl": [],
      "status": "enabled",
      "rewriteUrls": false,
      "addAutoRewriteRules": true,
      "autoRetryEnabled": false,
      "autoRetryPeriodMinutes": 60,
      "requestBody": true,
      "responseBody": true,
      "allow": [
        "emr",
        "test",
        "pipeline"
      ],
      "name": "SHR - FHIR Passthrough",
      "description": "Get or Post a new FHIR Resource to the SHR",
      "urlPattern": "^/SHR/fhir.*$",
      "routes": [
        {
          "type": "http",
          "status": "enabled",
          "forwardAuthHeader": false,
          "name": "SHR - Get/Create/Update Resource",
          "secured": false,
          "host": "shr",
          "port": 3000,
          "path": "",
          "pathTransform": "s/SHR\\/fhir/fhir/g",
          "primary": true,
          "username": "",
          "password": ""
        }
      ],
      "priority": 2
    },
    {
      "methods": [
        "GET"
      ],
      "type": "http",
      "whitelist": [],
      "authType": "private",
      "allow": [
        "emr",
        "shr"
      ],
      "matchContentTypes": [],
      "properties": [],
      "txViewAcl": [],
      "txViewFullAcl": [],
      "txRerunAcl": [],
      "status": "enabled",
      "rewriteUrls": false,
      "addAutoRewriteRules": true,
      "autoRetryEnabled": false,
      "autoRetryPeriodMinutes": 60,
      "name": "SHR - Consolidated IPS",
      "requestBody": false,
      "responseBody": true,
      "description": "Read-side: GET a unified IPS across all of a person's sites (SHR mediator /ips, MPI-resolved)",
      "urlPattern": "^/SHR/ips.*$",
      "routes": [
        {
          "type": "http",
          "status": "enabled",
          "forwardAuthHeader": false,
          "name": "SHR IPS",
          "secured": false,
          "host": "shr",
          "port": 3000,
          "path": "",
          "pathTransform": "s/SHR\\/ips/ips/g",
          "primary": true,
          "username": "",
          "password": ""
        }
      ],
      "alerts": [],
      "rewriteUrlsConfig": [],
      "priority": 1
    }
  ],
  "endpoints": [
      {
          "name": "SHR Endpoint",
          "host": "shr",
          "path": "/",
          "port": 3000,
          "primary": true,
          "forwardAuthHeader": false,
          "status": "enabled",
          "type": "http"
      }
  ]
}