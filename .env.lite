# SEDISH Haiti - Lite / Resource-Limited Environment Configuration
# Use this profile when deploying on servers with limited resources (8-16GB RAM)
# This profile runs only essential services with reduced memory allocations

# General
CLUSTERED_MODE=false
VERSION=v1.0.0-alpha.1

# Log
DEBUG=0
BASHLOG_FILE=1
BASHLOG_FILE_PATH=platform.log

# Interoperability Layer - OpenHIM
OPENHIM_CORE_INSTANCES=1
OPENHIM_CONSOLE_INSTANCES=1
OPENHIM_MEDIATOR_API_PORT=443
MONGO_SET_COUNT=1
OPENHIM_MONGO_URL=mongodb://mongo-1:27017/openhim
OPENHIM_MONGO_ATNAURL=mongodb://mongo-1:27017/openhim

# FHIR Datastore - HAPI FHIR (reduced memory)
HAPI_FHIR_INSTANCES=1
HAPI_FHIR_MAX_REPLICAS_PER_NODE=1
HAPI_FHIR_CPU_LIMIT=0
HAPI_FHIR_CPU_RESERVE=0.05
HAPI_FHIR_MEMORY_LIMIT=1G
HAPI_FHIR_MEMORY_RESERVE=256M
HF_JAVA_OPTS=-Xmx512m -Xms128m
REPMGR_PARTNER_NODES=postgres-1
POSTGRES_REPLICA_SET=postgres-1:5432
HAPI_DB_SET=postgres-1:5432
HF_POSTGRESQL_USERNAME=hapi
HF_POSTGRESQL_PASSWORD=hapi

# Database - Postgres (reduced memory)
POSTGRES_REPLICAS=1

# Database - MySQL (reduced memory)
MYSQL_CPU_LIMIT=0
MYSQL_CPU_RESERVE=0.1
MYSQL_MEMORY_LIMIT=1G
MYSQL_MEMORY_RESERVE=256M

# Reverse Proxy - Nginx (reduced memory)
REVERSE_PROXY_INSTANCES=1
NGINX_CPU_LIMIT=0
NGINX_CPU_RESERVE=0.05
NGINX_MEMORY_LIMIT=512M
NGINX_MEMORY_RESERVE=100M
DOMAIN_NAME=sedish.net
SUBDOMAINS=
RENEWAL_EMAIL=dummy@uw.org
STAGING=true
INSECURE=false

# iSantePlus - EMR (reduced memory, single instance by default)
# To enable only the first instance, set ISANTEPLUS_INSTANCES_2/3/4 to 0
OMRS_JAVA_MEMORY_OPTS=-Xmx768m -Xms256m -XX:NewSize=128m
ISANTEPLUS_INSTANCES_1=1
ISANTEPLUS_INSTANCES_2=0
ISANTEPLUS_INSTANCES_3=0
ISANTEPLUS_INSTANCES_4=0
ISANTEPLUS_CPU_LIMIT=0
ISANTEPLUS_CPU_RESERVE=0.05
ISANTEPLUS_MEMORY_LIMIT=1G
ISANTEPLUS_MEMORY_RESERVE=256M

# Data Pipeline (reduced memory)
PIPELINE_MEMORY_LIMIT=512M
PIPELINE_MEMORY_RESERVE=128M
